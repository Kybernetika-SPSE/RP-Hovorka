  (pad "7"  smd rect (at -2.25 0) (size 0.3 1.2) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "8"  smd rect (at -1.75 0) (size 0.3 1.2) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "9"  smd rect (at -1.25 0) (size 0.3 1.2) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "10" smd rect (at -0.75 0) (size 0.3 1.2) (layers "F.Cu" "F.Paste" "F.Mask"))
