(footprint "Hirose_FH12-22S-0.5SH"
  (layer "F.Cu")
  (descr "Hirose FH12-22S-0.5SH, 22-pin FPC connector, 0.5mm pitch, top contact")
  (tags "FPC FFC 22pin 0.5mm Hirose")

  (attr smd)

  (fp_text reference "J?"
    (at 0 -3.5)
    (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )

  (fp_text value "FH12-22S-0.5SH"
    (at 0 3.5)
    (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )

  ;; Silkscreen
  (fp_line (start -6.7 -2.3) (end 6.7 -2.3) (layer "F.SilkS") (width 0.12))
  (fp_line (start -6.7 2.3)  (end 6.7 2.3)  (layer "F.SilkS") (width 0.12))

  ;; Courtyard
  (fp_rect
    (start -7.2 -2.8)
    (end   7.2  2.8)
    (layer "F.CrtYd")
    (width 0.05)
  )

  ;; Pads (22 × 0.5mm pitch)
